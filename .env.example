# PaperSage configuration — copy to `.env` for local runs, or set these as
# GitHub Actions repository secrets for the scheduled digest.

# --- Required secrets ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_ADDRESS=ekambaranath23@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
RECIPIENT_EMAIL=ekambaranath23@gmail.com

# --- Optional overrides (sensible defaults baked in) ---
# Comma-separated research interests that drive every search.
PAPERSAGE_TOPICS=Agentic AI, AI agents, tool use, LLM reasoning, retrieval-augmented generation (RAG), multi-agent systems, new AI research

# Model slugs (OpenRouter).
SUMMARIZER_MODEL=stealth/ox-alpha
TRIAGE_MODEL=google/gemini-2.5-flash

# How many days back to look, and how many papers to keep per run.
LOOKBACK_DAYS=2
MAX_PAPERS=10

# Optional NCBI/Semantic Scholar keys raise rate limits but are NOT required.
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Set to 1 to skip actually sending email (prints report to console instead).
DRY_RUN=0
